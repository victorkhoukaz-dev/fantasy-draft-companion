{
  "manifest_version": 3,
  "name": "FantasyPoints Underdog Draft Relay",
  "version": "1.3.0",
  "description": "Seamless real-time pick sync between Underdog Fantasy draft rooms and FantasyPoints Draft Companion.",
  "icons": {
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://underdogfantasy.com/*",
        "*://*.underdogfantasy.com/*",
        "*://underdogsports.com/*",
        "*://*.underdogsports.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.github.io/*",
        "file:///*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "companion_relay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.underdogfantasy.com/*",
    "*://*.underdogsports.com/*",
    "*://*.github.io/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}